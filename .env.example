AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

# MQTT is optional. Configure a reachable broker to enable Gateway transport.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=meshmind-gateway
MESHMIND_API_PORT=8000

# Configure these only when using Cloud synchronization.
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
QDRANT_CLOUD_COLLECTION=meshmind_global_memory

# Optional hosted AI provider; select AI_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
